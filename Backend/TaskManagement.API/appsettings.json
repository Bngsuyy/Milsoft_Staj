{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:5173",
    "https://localhost:5173"
  ],
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=TaskManagementDb;Username=postgres",
    "Oracle": "User Id=taskmanagement;Data Source=localhost:1521/XEPDB1"
  },
  "DatabaseProvider": "PostgreSQL",
  "FileUpload": {
    "StoragePath": "App_Data/uploads",
    "MaxFileSizeBytes": 10485760
  },
  "JwtSettings": {
    "SecretKey": "CHANGE_THIS_WITH_A_SECURE_ENVIRONMENT_SECRET_32B",
    "Issuer": "TaskManagementAPI",
    "Audience": "TaskManagementUI",
    "ExpirationInMinutes": 120
  }
}
